{
  "name": "allegra",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "next build --webpack && electron .",
    "build:desktop": "next build --webpack && electron-builder --publish never",
    "build:desktop:win": "next build --webpack && electron-builder --win --publish never",
    "build:desktop:mac": "next build --webpack && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.576.0",
    "next": "16.1.6",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.allegra.inventario",
    "productName": "Allegra",
    "copyright": "Copyright © 2026 Allegra Producciones",
    "directories": {
      "output": "release",
      "buildResources": "electron-assets"
    },
    "asar": true,
    "asarUnpack": [
      ".next/**/*",
      "node_modules/**/*.node"
    ],
    "compression": "maximum",
    "files": [
      ".next/**/*",
      "public/**/*",
      "main.js",
      "next.config.ts",
      "package.json",
      "!**/.git/**",
      "!**/node_modules/**/.cache/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".env.local",
        "to": ".env.local",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.jpg",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Allegra-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Allegra Gestión",
      "installerIcon": "public/logo.jpg",
      "uninstallerIcon": "public/logo.jpg",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/logo.jpg",
      "darkModeSupport": true,
      "artifactName": "Allegra-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Allegra ${version}",
      "icon": "public/logo.jpg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": null
  }
}